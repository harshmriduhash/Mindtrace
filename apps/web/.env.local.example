# Local: call API directly, or use same-origin proxy (/api/v1 + API_ORIGIN).
NEXT_PUBLIC_API_URL=/api/v1
API_ORIGIN=http://localhost:8000

# Production (Vercel): set the same vars in the Vercel project.
# Root Directory = apps/web
# NEXT_PUBLIC_API_URL=/api/v1
# API_ORIGIN=https://your-api-host.example.com
