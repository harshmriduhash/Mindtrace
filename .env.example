# Shared
ENVIRONMENT=local
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000

# Database
# Local: sqlite:///./mindtrace.db
# Docker Postgres: postgresql+psycopg://mindtrace:mindtrace@localhost:5432/mindtrace
DATABASE_URL=sqlite:///./mindtrace.db

# Redis / queue
REDIS_URL=redis://localhost:6379/0

# Auth
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Object storage (MinIO local)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=mindtrace
S3_SECRET_KEY=mindtrace_secret
S3_BUCKET=mindtrace-sources
S3_REGION=us-east-1

# AI (optional — deterministic fallbacks used when empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=false

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/object_storage
SYNC_INGEST=true

# Email ESP (optional — logs verification links when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Mindtrace <noreply@mindtrace.local>

# India billing via Razorpay (Stripe not used)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin API
ADMIN_API_KEY=dev-admin-key-change-me
